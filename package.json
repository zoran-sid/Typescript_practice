{
  "name": "typescript_practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A project-based TypeScript course derived from zoranzhou.com",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
