    "branches:init": "node scripts/create-learning-branches.mjs",
    "verify": "node scripts/verify-solutions.mjs",
    "test": "npm run check && npm run verify"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.0.0"
  }
}
