{
  "name": "typescript_practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A zero-beginner TypeScript practice course",
  "scripts": {
    "check": "tsc -p beginner/tsconfig.check.json --noEmit",
    "beginner:doctor": "node beginner/scripts/doctor.mjs",
    "beginner:audit": "node beginner/scripts/audit.mjs",
    "beginner:check": "tsc -p beginner/tsconfig.check.json --noEmit",
    "beginner": "node beginner/scripts/run.mjs practice",
    "beginner:example": "node beginner/scripts/run.mjs example",
    "beginner:solution": "node beginner/scripts/run.mjs solution",
    "beginner:verify": "node beginner/scripts/verify.mjs",
    "official:sync": "node beginner/scripts/sync-official-docs.mjs",
    "test:practice": "node beginner/scripts/audit.mjs --allow-answers && npm run beginner:check && npm run beginner:verify",
    "test": "npm run beginner:audit && npm run beginner:check && npm run beginner:verify"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.0.0"
  }
}
