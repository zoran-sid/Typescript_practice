{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "lib": ["ES2022", "DOM", "ESNext.Decorators"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["day*/**/*.ts"],
  "exclude": ["day*/practice*.ts"]
}
